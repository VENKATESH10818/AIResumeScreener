# ============================================================
# AI Resume Screener — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# --- Database ---
# SQLite (default, no setup required):
DATABASE_URL=sqlite+aiosqlite:///./storage/resume_screener.db
# PostgreSQL (swap in when you're ready to scale):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/resume_screener

# --- File Storage ---
# Local path where uploaded resume files are saved
STORAGE_PATH=./storage/resumes

# --- FAISS Vector Index ---
FAISS_INDEX_PATH=./storage/faiss_index/index.faiss
FAISS_IDS_PATH=./storage/faiss_index/index_ids.npy

# --- Embedding Model ---
# Lightweight & fast (384-dim):
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Higher accuracy (768-dim, ~3x slower on CPU):
# EMBEDDING_MODEL=all-mpnet-base-v2

# --- spaCy Model ---
SPACY_MODEL=en_core_web_sm

# --- CORS (comma-separated origins for the React UI) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
